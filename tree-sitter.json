{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "fels",
      "camelcase": "Fels",
      "title": "Fels",
      "scope": "source.fels",
      "file-types": ["fels", "gab"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "path": "."
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Tree-sitter grammar for the Fels programming language",
    "authors": [{ "name": "Christian Brendlin" }]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
